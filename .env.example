# Copy to .env and fill in the blanks. Never commit .env.

# ---- LLM (any OpenAI-compatible endpoint) ----
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Set to false for models without native tool calling; the investigator then
# uses the structured JSON action protocol.
LLM_SUPPORTS_TOOL_CALLING=true
LLM_TIMEOUT_S=120
# Upper bound on one completion's output; this is the cost ceiling per call.
LLM_MAX_TOKENS=2000
# Transport retries for failures that can succeed on a second attempt
# (rate limit, timeout, connection, 5xx). Auth and bad-request failures are not.
LLM_MAX_RETRIES=1
# Set to false if the endpoint rejects response_format={"type": "json_object"}.
LLM_JSON_MODE=true

# ---- Database backend ----
# mock: in-memory SQLite, seeded deterministically. No PostgreSQL required.
DATABASE_BACKEND=mock
# postgres: requires DATABASE_URL and a read-only role.
# DATABASE_BACKEND=postgres
# DATABASE_URL=postgresql+psycopg://analyst:change-me@localhost:5432/analytics

# ---- Mock data (backend=mock) ----
# Anchor date for generated history. Empty means "today".
REFERENCE_DATE=
MOCK_SEED=42
MOCK_MONTHS=24

# ---- Investigation limits ----
MAX_STEPS=12
# Model turns allowed in the investigation loop.
MAX_TOOL_TURNS=12
# Statements that may reach the database in one investigation.
MAX_QUERIES=8
# Failures allowed after the first attempt (0 means no retry).
MAX_QUERY_RETRIES=2
MAX_ROWS=500
MAX_SQL_LENGTH=20000
STATEMENT_TIMEOUT_MS=15000
CONTEXT_BUDGET=24000
WALL_CLOCK_S=600

# ---- Observability ----
TRACE_DIR=traces
# Rows of each result kept as evidence in the report and JSON output.
TRACE_SAMPLE_ROWS=5
